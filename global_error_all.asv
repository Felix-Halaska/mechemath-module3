t_ref = [0, .492];
h_step = logspace(-5, 0, 100);

test_func = @rate_func02;

XA = solution02(t_ref(1));
gt = solution02(t_ref(end));

fe_err_list = [];
mp_err_list = [];
be_err_list = [];
imp_err_list = [];
gt_err_list = [];

fe_evals_list = [];
mp_evals_list = [];
be_evals_list = [];
imp_evals_list = [];

for i = 1:length(h_step)
    [t_list_fe, x_list_fe, ~, num_evals_fe] = forward_euler_fixed_step_integration(test_func, t_ref, XA, h_step(i));
    [t_list_mp, x_list_mp, ~, num_evals_mp] = explicit_midpoint_fixed_step_integration(test_func, t_ref, XA, h_step(i));
    [t_list_be, x_list_be, ~, num_evals_be] = backward_euler_fixed_step_integration(test_func, t_ref, XA, h_step(i));
    [t_list_imp, x_list_imp, ~, num_evals_imp] = implicit_midpoint_fixed_step_integration(test_func, t_ref, XA, h_step(i));

   
    XB_fe = x_list_fe(:,end);
    XB_mp = x_list_mp(:,end);
    XB_be = x_list_be(:,end);
    XB_imp = x_list_imp(:,end);

    fe_err_list = [fe_err_list, norm(XB_fe - gt)];
    mp_err_list = [mp_err_list, norm(XB_mp - gt)];
    be_err_list = [be_err_list, norm(XB_be - gt)];
    imp_err_list = [imp_err_list, norm(XB_imp - gt)];

    fe_evals_list = [fe_evals_list, num_evals_fe];
    mp_evals_list = [mp_evals_list, num_evals_mp];
    be_evals_list = [be_evals_list, num_evals_be];
    imp_evals_list = [imp_evals_list, num_evals_imp];

    gt_err_list = [gt_err_list, norm(gt - XA)];


end

filtered_h_step = h_step(1:end-4);
filt_length = length(filtered_h_step);

filtered_fe_err = fe_err_list(1:filt_length);
filtered_mp_err = mp_err_list(1:filt_length);
filtered_be_err = be_err_list(1:filt_length);
filtered_imp_err = imp_err_list(1:filt_length);
filtered_gt_err = gt_err_list(1:filt_length);


mp_p = polyfit(log(filtered_h_step), log(filt), 1)
fe_p = polyfit(log(h_step), log(fe_err_list), 1)
be_p = polyfit(log(h_step), log(be_err_list), 1)
imp_p = polyfit(log(h_step), log(imp_err_list), 1)

gt_p = polyfit(log(h_step), log(gt_err_list), 1)

mp_eval_p = polyfit(log(mp_evals_list), log(mp_err_list), 1)
fe_eval_p = polyfit(log(fe_evals_list), log(fe_err_list), 1)
be_eval_p = polyfit(log(be_evals_list), log(be_err_list), 1)
imp_eval_p = polyfit(log(imp_evals_list), log(imp_err_list), 1)


% figure();
% scatter(h_step, mp_err_list, "r")
% hold on
% scatter(h_step, fe_err_list, "g")
% scatter(h_step, be_err_list, "b");
% scatter(h_step, imp_err_list, "k");
% % scatter(h_step, gt_err_list);
% hold off
% set(gca,'xscale','log')
% set(gca,'yscale','log')
% legend(["Explicit Midpoint","Forward Euler", "Backward Euler", "Implicit Midpoint"], Location = "northwest", Interpreter="latex", FontSize=14)
% xlabel("h step (-)", Interpreter="latex", FontSize=14)
% ylabel("error (-)", Interpreter="latex", FontSize=14)
% % axis([0 4*pi -1.5 1.5])
% title("All Methods Global Error", Interpreter='latex', FontSize=16)
% ax = gca;
% ax.FontSize = 14;
% ax.XAxis.TickLabelInterpreter = 'Latex';
% ax.YAxis.TickLabelInterpreter = 'Latex';
% % exportgraphics(gca, 'plots/all_methods_global_error_testfunc1.png', 'Resolution',300)

figure();
scatter(mp_evals_list, mp_err_list, "r")
hold on
scatter(fe_evals_list, fe_err_list, "g")
scatter(be_evals_list, be_err_list, "b")
scatter(imp_evals_list, imp_err_list, "k")
% scatter(h_step, gt_err_list);
hold off
set(gca,'xscale','log')
set(gca,'yscale','log')
legend(["Explicit Midpoint","Forward Euler", "Backward Euler", "Implicit Midpoint"], Location = "northeast", Interpreter="latex", FontSize=14)
xlabel("Number of Rate Function Calls (-)", Interpreter="latex", FontSize=14)
ylabel("Error (-)", Interpreter="latex", FontSize=14)
% axis([0 4*pi -1.5 1.5])
title("All Methods Global Error", Interpreter='latex', FontSize=16)
ax = gca;
ax.FontSize = 14;
ax.XAxis.TickLabelInterpreter = 'Latex';
ax.YAxis.TickLabelInterpreter = 'Latex';
% exportgraphics(gca, 'plots/all_methods_global_error_num_evals_testfunc1.png', 'Resolution',300)



