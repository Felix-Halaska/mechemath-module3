subplot(2, 2, 4);
t_space = linspace(0,20,20/0.01);
true_sol = solution01(t_space);
[t_list_imp, X_list_imp, h_avg, num_evals] = implicit_midpoint_fixed_step_integration(@rate_func01, [0,20], 1, .38);
